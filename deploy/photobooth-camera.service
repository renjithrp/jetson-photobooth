# Unified Sony camera daemon: holds the single PC-Remote session and serves BOTH the
# live view (MJPEG on :8080/) AND capture (GET :8080/capture = AF + shutter + download
# into BOOTH_CAPTURE_DIR). The backend's sony_hub consumes the live view; capture_service
# calls /capture. Exits cleanly when the camera is absent/asleep — systemd restarts it,
# so it reconnects automatically (seamless plug-and-play).
[Unit]
Description=PhotoBooth Pro Sony camera daemon (live view + capture)
After=network-online.target
# Never stop retrying: when the camera is off/asleep the daemon exits "no camera".
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/opt/CrSDK/external/crsdk
Environment=BOOTH_CAPTURE_DIR=/opt/photobooth/data/incoming
Environment=BOOTH_KEEPALIVE_SEC=25
ExecStart=/opt/CrSDK/external/crsdk/cameraDaemon
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
