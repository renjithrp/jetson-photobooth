# Chromium kiosk that shows the booth UI fullscreen on the Pi's display.
# The official Orange Pi 5B image autologs into XFCE as root on :0 (lightdm).
# If your image autologs a different user, change User= and XAUTHORITY accordingly.
[Unit]
Description=AI Photo Booth kiosk (Chromium)
After=graphical.target photobooth.service
Wants=photobooth.service

[Service]
Type=simple
User=root
Environment=DISPLAY=:0
Environment=XAUTHORITY=/var/run/lightdm/root/:0
ExecStartPre=/bin/sh -c 'until curl -skf https://localhost:8000/ >/dev/null || curl -sf http://localhost:8000/ >/dev/null; do sleep 1; done'
ExecStart=/opt/photobooth/deploy/start-kiosk.sh
Restart=always
RestartSec=5

[Install]
WantedBy=graphical.target
